{
  "schemaVersion": 1,
  "id": "hooked",
  "version": "${version}",

  "name": "Hooked",
  "description": "Hooked: Grappling hooks done simple, natural, and useful.",
  "authors": [
    "thecodewarrior"
  ],
  "contact": {
    "homepage": "https://curseforge.com/minecraft/mc-mods/hooked",
    "sources": "https://github.com/thecodewarrior/Hooked",
    "issues": "https://github.com/thecodewarrior/Hooked/issues",
    "discord": "https://discord.gg/wsk2PBR"
  },

  "license": "",
  "icon": "hooked_logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.thecodewarrior.hooked.fabric.HookedFabricCommon"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.thecodewarrior.hooked.fabric.HookedFabricClient"
      }
    ],
    "server": [
      {
        "adapter": "kotlin",
        "value": "dev.thecodewarrior.hooked.fabric.HookedFabricServer"
      }
    ],
    "cardinal-components": [
      {
        "adapter": "kotlin",
        "value": "dev.thecodewarrior.hooked.fabric.HookedCardinalComponents"
      }
    ]
  },
  "mixins": [
    "hooked.mixins.json",
    "hooked-fabric.mixins.json"
  ],

  "depends": {
    "minecraft": "${dep_minecraft}",
    "fabric-api": ">=${dep_fabricApi}",
    "fabric-language-kotlin": ">=${dep_fabricLanguageKotlin}",
    "fabric-key-binding-api-v1": "*",
    "architectury": ">=${dep_architectury}",
    "liblib_mosaic": ">=${dep_liblib}",
    "liblib_glitter": ">=${dep_liblib}",
    "liblib_etcetera": ">=${dep_liblib}",
    "trinkets": ">=${dep_trinkets}",
    "cardinal-components-base": ">=${dep_cardinalComponents}",
    "cardinal-components-entity": ">=${dep_cardinalComponents}"
  },
  "custom": {
    "cardinal-components": [
      "hooked:hook_data"
    ]
  }
}